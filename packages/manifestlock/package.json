{
  "name": "manifestlock",
  "version": "0.1.1",
  "description": "Detect manifest confusion in npm packages by diffing registry metadata against actual tarball package.json",
  "keywords": [
    "security",
    "manifest-confusion",
    "npm",
    "audit",
    "supply-chain",
    "tarball",
    "diff"
  ],
  "author": "Signal Tools Authors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/being-cheema/signal-tools",
    "directory": "packages/manifestlock"
  },
  "bugs": {
    "url": "https://github.com/being-cheema/signal-tools/issues"
  },
  "homepage": "https://github.com/being-cheema/signal-tools#readme",
  "type": "module",
  "bin": {
    "manifestlock": "dist/cli.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "lint": "eslint .",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "tar": "^7.4.3"
  },
  "devDependencies": {
    "@types/tar": "^6.1.13"
  }
}
